<Page
    x:Class="Waio.Shell.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        所有设置页同一个版式(切换 / 操作时不要位移):内容靠左、最宽 920、同样的边距;
        BringIntoViewOnFocusChange=False:某一节重建、焦点跳走时不自动滚动(否则整页跳一下)。
    -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid Padding="36,28,36,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="920" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock Text="通用" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="ElevationBar" IsOpen="True" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="RelaunchButton" Content="以管理员身份重新启动" Click="OnRelaunch" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border
                x:Name="AutostartCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource WaioCardCornerRadius}">
                <StackPanel Spacing="4">
                    <ToggleSwitch
                        x:Name="AutostartSwitch"
                        Header="开机自动启动"
                        OnContent="已启用"
                        OffContent="未启用"
                        IsEnabled="False"
                        Toggled="OnAutostartToggled" />
                    <!-- 预留一行高度:结果文字出现时卡片不长高,下面的内容不往下跳 -->
                    <TextBlock
                        x:Name="AutostartMessage"
                        MinHeight="16"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="UpdateCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource WaioCardCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch
                        x:Name="AutoUpdateSwitch"
                        Header="自动检查更新(每天一次,只访问 GitHub 的发布页面)"
                        OnContent="开"
                        OffContent="关"
                        Toggled="OnAutoUpdateToggled" />
                    <!-- 结果、进度都预留位置:出现时卡片不长高 -->
                    <TextBlock
                        x:Name="UpdateMessage"
                        MinHeight="16"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="UpdateProgress" Maximum="1" Opacity="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdate" />
                        <Button
                            x:Name="InstallUpdateButton"
                            Content="下载并安装"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed"
                            Click="OnInstallUpdate" />
                        <Button x:Name="ReleaseNotesButton" Content="查看发布页面" Click="OnOpenReleaseNotes" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 远程桌面(ADR-0033),代码里构建,修改后整体重建 -->
            <ContentPresenter x:Name="RemoteDesktopHost" />

            <Border
                x:Name="DiagnosticsCard"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource WaioCardCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock Text="诊断信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="DiagnosticsText"
                        FontFamily="Consolas"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Click="OnRefreshDiagnostics" />
                        <Button Content="打开日志文件夹" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
