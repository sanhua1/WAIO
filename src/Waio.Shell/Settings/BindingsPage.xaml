<Page
    x:Class="Waio.Shell.Settings.BindingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 快捷键总表(ADR-0011,结构参考 MAIO 的 ShortcutsPane):搜索、按功能分组、启停、编辑、状态徽标 -->
    <!-- 版式同 GeneralPage(靠左、最宽 920、焦点变化不自动滚动),见那里的说明 -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid Padding="36,28,36,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="920" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="WAIO 快捷键" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Margin="0,2,0,12"
                Text="点击键帽直接录制新组合;双击一行或用右侧菜单编辑命令、参数和生效范围。改动立即生效。"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- 自定义修饰键(ADR-0012),内容由代码生成 -->
            <ContentControl x:Name="ModifiersHost" HorizontalContentAlignment="Stretch" Margin="0,0,0,12" />

            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="Search"
                    PlaceholderText="搜索快捷键、命令或程序"
                    QueryIcon="Find"
                    TextChanged="OnSearchChanged" />
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAdd">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加快捷键" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                x:Name="EngineBar"
                Severity="Warning"
                Title="快捷键服务没有运行"
                Message="快捷键暂不生效,也不能录制。仍可以手动选择按键来编辑。"
                IsClosable="False" />
            <InfoBar
                x:Name="ErrorBar"
                Severity="Warning"
                Title="快捷键配置里有无法识别的条目,已忽略"
                IsClosable="False" />

            <StackPanel x:Name="Groups" Spacing="4" />

            <StackPanel
                x:Name="EmptyState"
                Margin="0,48"
                Spacing="10"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE765;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,24,0,0">
                <HyperlinkButton Content="打开配置文件夹" Click="OnOpenFolder" />
                <HyperlinkButton Content="重新加载快捷键配置" Click="OnReload" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
