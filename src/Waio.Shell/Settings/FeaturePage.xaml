<Page
    x:Class="Waio.Shell.Settings.FeaturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 版式同 GeneralPage(靠左、最宽 920、焦点变化不自动滚动),见那里的说明 -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid Padding="36,28,36,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="920" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
            <!-- 页头:图标 + 名字 + 一句话说明 -->
            <Grid ColumnSpacing="16" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="IconBox"
                    Width="52"
                    Height="52"
                    CornerRadius="{ThemeResource WaioCardCornerRadius}"
                    Background="{ThemeResource WaioAccentSoftBrush}">
                    <FontIcon x:Name="Icon" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="Body" Spacing="4" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
