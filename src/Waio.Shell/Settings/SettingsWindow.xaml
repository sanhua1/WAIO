<Window
    x:Class="Waio.Shell.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WAIO 设置">
    <!-- 背景:磨砂玻璃(ADR-0026),在代码里由 Glass.Attach 挂上,参数跟随"外观"设置 -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            自绘标题栏(不要 Windows 自带的标题栏):内容延伸到标题栏,这一行是拖动区,
            和玻璃背景融为一体;右边的最小化 / 最大化 / 关闭按钮仍由系统绘制(颜色在代码里随深浅色设置)。
        -->
        <Grid x:Name="AppTitleBar" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock
                    Text="WAIO"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="设置"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!--
            悬浮侧栏(ADR-0026):导航栏本身透明,背后垫一块圆角玻璃面板,选中项是强调色淡胶囊(没有左侧竖条)。
            面板宽度 = OpenPaneLength - 左右各 8;导航项左右各缩进 12,刚好落在面板里面。
            左边距和下边距相等(8),圆角和窗口外框一样(8):和窗口左下角对齐(原来对不上)。
        -->
        <Border
            x:Name="Sidebar"
            Grid.Row="1"
            Width="232"
            Margin="8,0,0,8"
            HorizontalAlignment="Left"
            BorderThickness="1"
            CornerRadius="{ThemeResource WaioCardCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!--
            结构参考 MAIO(ADR-0010):上面是全局页,下面"功能"分组每个功能一项(由代码按 manifest 生成),
            点进去是该功能的开关、状态、快捷键和它自带的设置。
        -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="248"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewItemButtonMargin">14,2</Thickness>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
                <Thickness x:Key="NavigationViewPaneContentGridMargin">0,8</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="通用" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="WAIO 快捷键" Tag="bindings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统快捷键" Tag="system-shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="功能" />
            </NavigationView.MenuItems>
            <!-- 不要内容过渡动画(切页时不滑动),见 SettingsWindow.NoTransition -->
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection />
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
