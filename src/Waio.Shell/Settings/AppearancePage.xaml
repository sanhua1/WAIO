<Page
    x:Class="Waio.Shell.Settings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 版式同 GeneralPage(靠左、最宽 920、焦点变化不自动滚动)。内容由代码生成(ADR-0027) -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid Padding="36,28,36,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="外观" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="调整 WAIO 窗口的磨砂玻璃效果,深浅色跟随系统。改动立即生效,并自动保存。" />
                <ContentControl x:Name="Body" HorizontalContentAlignment="Stretch" IsTabStop="False" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
