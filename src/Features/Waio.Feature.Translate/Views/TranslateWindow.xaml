<Window
    x:Class="Waio.Feature.Translate.Views.TranslateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="翻译">

    <!--
        布局同 MAIO TranslateView:顶部标题栏(拖动、固定、关闭)→ 原文输入 → 语言栏 → 各翻译源的结果卡片。
        窗口高度始终等于内容高度(结果陆续出现时自动变高),见 TranslateWindow.Layout.cs。
    -->
    <StackPanel x:Name="Root" Padding="12,0,12,12" Spacing="10" VerticalAlignment="Top" PreviewKeyDown="OnRootKeyDown">
        <StackPanel.Resources>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="7" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </StackPanel.Resources>

        <!-- 标题栏:拖动这一栏移动窗口(其余地方可以自由选择文字) -->
        <Grid x:Name="Header" Height="40" Margin="-12,0" Padding="14,0,6,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="HeaderIcon" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="翻译" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Name="PinButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="OnPinClick">
                <FontIcon x:Name="PinIcon" FontSize="14" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButton}" Click="OnCloseClick">
                <FontIcon x:Name="CloseIcon" FontSize="13" />
            </Button>
        </Grid>

        <!-- 原文:回车翻译,Shift+回车换行 -->
        <TextBox x:Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="输入要翻译的文字,回车翻译,Shift+回车换行"
                 PreviewKeyDown="OnSourceKeyDown" TextChanged="OnSourceChanged" />

        <!-- 源语言 ⇄ 目标语言,以及"删除换行" -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceLanguageBox" MinWidth="120" SelectionChanged="OnSourceLanguageChanged" />
            <Button x:Name="SwapButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="OnSwapClick">
                <FontIcon x:Name="SwapIcon" FontSize="13" />
            </Button>
            <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" MinWidth="120" SelectionChanged="OnTargetLanguageChanged" />
            <Button x:Name="LineBreaksButton" Grid.Column="4" Style="{StaticResource IconButton}" Click="OnRemoveLineBreaksClick">
                <FontIcon x:Name="LineBreaksIcon" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="ResultsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel" Spacing="8" />
        </ScrollViewer>
    </StackPanel>
</Window>
