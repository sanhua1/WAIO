<Window
    x:Class="Waio.Feature.Launcher.UI.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Waio.Feature.Launcher.UI"
    Title="启动台">

    <!--
        布局同 MAIO 的启动器面板:搜索框 → 来源标签 → 结果列表(分组)+ 右侧预览 → 按键提示。尺寸按显示器百分比(PanelGeometry),不随结果数变化(顶部不会跳)。
        外观沿用剪贴板面板:一块毛玻璃,各部分之间一像素分隔线,行自己绘制(不用 ListView 自带的焦点框和选中条)。
    -->
    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="5,1,5,2" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="KeyCapText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="34" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <Grid Padding="20,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Glyph="&#xE721;"
                FontSize="18"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Padding="0,6"
                MinHeight="0"
                FontSize="20"
                VerticalAlignment="Center"
                PlaceholderText="搜索应用、文件、网页…"
                PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                TextChanged="OnQueryChanged"
                TextCompositionStarted="OnCompositionStarted"
                TextCompositionEnded="OnCompositionEnded" />
        </Grid>

        <!-- 来源标签(代码里按 LauncherSources.Available 生成) -->
        <Grid Grid.Row="1" Padding="16,0,16,6">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <TextBlock
                x:Name="TabStatus"
                Style="{StaticResource HintText}"
                HorizontalAlignment="Right" />
        </Grid>

        <Rectangle Grid.Row="2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 左边结果列表,右边预览;面板太窄时收起预览(PanelGeometry.ShowsPreview) -->
        <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="3*" />
            <ColumnDefinition x:Name="PreviewDividerColumn" Width="1" />
            <ColumnDefinition x:Name="PreviewColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            x:Name="Scroller"
            Padding="8,4,8,8"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater
                x:Name="Repeater"
                ItemsSource="{x:Bind Rows}"
                ElementPrepared="OnElementPrepared">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:LauncherRow">
                        <Grid Height="{x:Bind Height}" Padding="{x:Bind RowPadding}" Background="Transparent">
                            <!-- 分组标题 -->
                            <TextBlock
                                Text="{x:Bind Title}"
                                Margin="12,8,0,0"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind HeaderVisibility}" />

                            <!-- 结果 -->
                            <Grid
                                Background="Transparent"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind ItemVisibility}"
                                CanDrag="True"
                                DragStarting="OnRowDragStarting"
                                DropCompleted="OnRowDropCompleted"
                                PointerPressed="OnRowPointerPressed"
                                DoubleTapped="OnRowDoubleTapped"
                                PointerEntered="OnRowPointerEntered"
                                PointerExited="OnRowPointerExited">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="打开" Tag="{x:Bind}" Click="OnMenuOpen" />
                                        <MenuFlyoutItem Text="打开文件位置" Tag="{x:Bind}" Click="OnMenuReveal" IsEnabled="{x:Bind HasPath}" />
                                        <MenuFlyoutItem Text="复制路径" Tag="{x:Bind}" Click="OnMenuCopy" IsEnabled="{x:Bind CanCopy}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <Border
                                    CornerRadius="{x:Bind Corner}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                <Border
                                    CornerRadius="{x:Bind Corner}"
                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                    Visibility="{x:Bind HoverVisibility, Mode=OneWay}" />
                                <Border
                                    Width="3"
                                    Height="{x:Bind BarHeight}"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                                <Grid Padding="12,0,14,0" ColumnSpacing="12" Visibility="{x:Bind DetailedVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="{x:Bind Glyph}"
                                            FontSize="18"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="14"
                                            MaxLines="1"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle}"
                                            FontSize="11"
                                            MaxLines="1"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Visibility="{x:Bind SubtitleVisibility}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind KindLabel}" Style="{StaticResource HintText}" />
                                        <TextBlock
                                            Text="{x:Bind SlotText}"
                                            Width="44"
                                            TextAlignment="Right"
                                            Style="{StaticResource HintText}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 极简(文件、文件夹的默认样式,同 Everything):一行,小图标 + 名称 + 所在文件夹 -->
                                <Grid Padding="10,0,12,0" ColumnSpacing="8" Visibility="{x:Bind CompactVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="{x:Bind Glyph}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Subtitle}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Spacing="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE721;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyMessage" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Rectangle x:Name="PreviewDivider" Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 预览:第一行完整文件名,第二行完整路径,下面是内容(文本 / 图片 / 类型 + 没有预览) -->
        <Grid x:Name="PreviewPane" Grid.Column="2" Padding="16,12,16,12" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 单击复制:悬停时底色变深,提示"单击复制" -->
            <Border
                x:Name="PreviewNameButton"
                Margin="-6,0"
                Padding="6,3"
                CornerRadius="4"
                Background="Transparent"
                ToolTipService.ToolTip="单击复制文件名"
                Tapped="OnPreviewNameTapped"
                PointerEntered="OnPreviewCopyPointerEntered"
                PointerExited="OnPreviewCopyPointerExited">
                <TextBlock
                    x:Name="PreviewName"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            <Border
                x:Name="PreviewPathButton"
                Grid.Row="1"
                Margin="-6,0"
                Padding="6,3"
                CornerRadius="4"
                Background="Transparent"
                ToolTipService.ToolTip="单击复制路径"
                Tapped="OnPreviewPathTapped"
                PointerEntered="OnPreviewCopyPointerEntered"
                PointerExited="OnPreviewCopyPointerExited">
                <TextBlock
                    x:Name="PreviewPath"
                    FontSize="11"
                    TextWrapping="Wrap"
                    MaxLines="4"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <Grid x:Name="PreviewBody" Grid.Row="2" Margin="0,10,0,0">
                <ScrollViewer
                    x:Name="PreviewTextScroller"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="PreviewText"
                        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
                <Image
                    x:Name="PreviewImage"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="PreviewNone"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <FontIcon x:Name="PreviewGlyph" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="PreviewIcon" Width="64" Height="64" Stretch="Uniform" />
                    </Grid>
                    <TextBlock
                        x:Name="PreviewType"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="PreviewNoneText"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>

        <Rectangle Grid.Row="4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 右下角齿轮:打开 WAIO 设置(ADR-0025) -->
        <Button
            x:Name="SettingsButton"
            Grid.Row="5"
            Margin="0,0,8,0"
            Padding="6,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            IsTabStop="False"
            ToolTipService.ToolTip="WAIO 设置"
            Click="OnSettingsButtonClick">
            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Button>

        <StackPanel Grid.Row="5" Padding="16,0" Orientation="Horizontal" Spacing="6">
            <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#x23CE;" Style="{StaticResource KeyCapText}" /></Border>
            <TextBlock Text="打开" Style="{StaticResource HintText}" />
            <Border Margin="8,0,0,0" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl &#x23CE;" Style="{StaticResource KeyCapText}" /></Border>
            <TextBlock Text="打开文件位置" Style="{StaticResource HintText}" />
            <Border Margin="8,0,0,0" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl C" Style="{StaticResource KeyCapText}" /></Border>
            <TextBlock Text="复制路径" Style="{StaticResource HintText}" />
            <Border Margin="8,0,0,0" Style="{StaticResource KeyCap}"><TextBlock Text="Tab" Style="{StaticResource KeyCapText}" /></Border>
            <TextBlock Text="切换来源" Style="{StaticResource HintText}" />
            <Border Margin="8,0,0,0" Style="{StaticResource KeyCap}"><TextBlock Text="Esc" Style="{StaticResource KeyCapText}" /></Border>
            <TextBlock Text="关闭" Style="{StaticResource HintText}" />
        </StackPanel>
    </Grid>
</Window>
